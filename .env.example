# Copy this file to .env.local for local development. Do not commit .env.local.
# Use the anon key from the D&D Encounter Builder Supabase project.
# Never put a Supabase service role key in browser env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local/sample data remains active until persistence is wired.
NEXT_PUBLIC_USE_DEMO_DATA=true

# Set to true locally to show the in-progress SRD import tools in the Importer.
NEXT_PUBLIC_ENABLE_SRD_IMPORT=false
