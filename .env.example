# Copy this file to .env.local for local development. Do not commit .env.local.
# Use values from the fresh D&D Encounter Builder Supabase project.
# Never put a Supabase service role key, database password, JWT secret, or private API key in browser env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set true only for local demos. Leave false for Vercel beta/prod.
NEXT_PUBLIC_USE_DEMO_DATA=false

# Set to true locally to show the in-progress SRD import tools in the Importer.
NEXT_PUBLIC_ENABLE_SRD_IMPORT=false
